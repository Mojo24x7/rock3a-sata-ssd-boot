#!/bin/sh
# /etc/initramfs-tools/scripts/panic/pcie-sbr-diag
#
# Runs when initramfs is about to drop to a rescue shell. Collects everything useful
# about why the root device is missing and ships it over raw TCP to DIAG_HOST, so a
# headless board with no serial console can still tell you what went wrong.
#
# Receiving end:  python3 tools/diag_listener.py
#
# NOTE: `rootwait` does NOT prevent this hook from running. In an initramfs boot the
# initramfs does the waiting, and initramfs-tools/init parses only `rootdelay=` -- the
# kernel's own `rootwait` never gets a chance. scripts/local gives up after ~30s of wall
# clock and panics, which is when this runs. The log that scripts/local-block/pcie-sbr
# writes to /run is also worth reading, and survives into the booted system on success.
PREREQ=""
prereqs(){ echo "$PREREQ"; }
case $1 in
  prereqs) prereqs; exit 0 ;;
esac

DIAG_PORT=9999
NET_IFACE=eth0
[ -r /etc/pcie-sbr-boot.conf ] && . /etc/pcie-sbr-boot.conf

# Restart the emergency shell. It is started in init-premount but does NOT survive the drop
# to the panic shell - measured twice on a ROCK 3A: the port was refused while the board sat
# at the rescue prompt, so there was no interactive channel exactly when one was needed.
# NOTE: this is `nc -ll -e`, NOT telnetd -- Debian's busybox has no telnetd applet at all
# (verified with `busybox --list`), which is why five boots logged "telnetd on port 23"
# while nothing listened.
if [ "${ENABLE_TELNET:-no}" = "yes" ] && command -v busybox >/dev/null 2>&1; then
  busybox nc -ll -p "${TELNET_PORT:-23}" -e /bin/sh >/dev/null 2>&1 &
  NCPID=$!
  sleep 1
  if kill -0 "$NCPID" 2>/dev/null; then
    echo "$NCPID" > /run/pcie-sbr-nc.pid
    echo "[panic] nc shell listening on port ${TELNET_PORT:-23} pid $NCPID" >> /run/pcie-sbr.log
  else
    echo "[panic] nc shell FAILED to start" >> /run/pcie-sbr.log
  fi
fi

[ -n "${DIAG_HOST:-}" ] || exit 0

OUT=/run/pcie-sbr-report.txt

{
  echo "===== initramfs boot diagnosis ====="
  echo "date: $(date 2>/dev/null)"
  echo
  echo "--- /proc/cmdline"; cat /proc/cmdline 2>/dev/null
  echo
  echo "--- block devices"; ls -l /dev/sd* /dev/nvme* /dev/mmcblk* 2>/dev/null
  echo "--- /sys/block"; ls /sys/block/ 2>/dev/null
  echo
  echo "--- /dev/disk/by-uuid";     ls -l /dev/disk/by-uuid/ 2>/dev/null
  echo "--- /dev/disk/by-partuuid"; ls -l /dev/disk/by-partuuid/ 2>/dev/null
  echo
  echo "--- PCI devices"
  for d in /sys/bus/pci/devices/*; do
    [ -d "$d" ] || continue
    printf "%s vendor=%s device=%s class=%s driver=%s\n" \
      "$(basename "$d")" \
      "$(cat "$d/vendor" 2>/dev/null)" "$(cat "$d/device" 2>/dev/null)" \
      "$(cat "$d/class"  2>/dev/null)" \
      "$(readlink "$d/driver" 2>/dev/null | sed 's|.*/||')"
  done
  echo
  echo "--- /proc/bus/pci/devices"; cat /proc/bus/pci/devices 2>/dev/null
  echo
  echo "--- SCSI hosts"
  for h in /sys/class/scsi_host/host*; do
    [ -d "$h" ] && printf "%s proc_name=%s\n" "$(basename "$h")" "$(cat "$h/proc_name" 2>/dev/null)"
  done
  echo
  echo "--- recovery hook log"
  cat /run/pcie-sbr.log 2>/dev/null || echo "(none - local-block hook never ran)"
  echo
  echo "--- FULL dmesg"; dmesg 2>/dev/null
  echo "===== END ====="
} > "$OUT" 2>&1

# network may already be up from init-premount; if not, bring it up now
ip link set "$NET_IFACE" up 2>/dev/null || ifconfig "$NET_IFACE" up 2>/dev/null
ip addr show "$NET_IFACE" 2>/dev/null | grep -q 'inet ' || {
  sleep 2
  ipconfig -t 20 "$NET_IFACE" >> "$OUT" 2>&1 || udhcpc -i "$NET_IFACE" -n -q -t 6 >> "$OUT" 2>&1
}

for try in 1 2 3; do
  nc "$DIAG_HOST" "$DIAG_PORT" < "$OUT" && break
  sleep 3
done

# last resort: stash it on any FAT partition that did appear
for p in /dev/sda1 /dev/sda2 /dev/nvme0n1p1; do
  [ -b "$p" ] || continue
  mkdir -p /run/fat 2>/dev/null
  mount -t vfat "$p" /run/fat 2>/dev/null || continue
  cp "$OUT" /run/fat/boot-diag.txt 2>/dev/null
  umount /run/fat 2>/dev/null
  break
done

exit 0
