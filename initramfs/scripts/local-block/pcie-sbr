#!/bin/sh
# /etc/initramfs-tools/scripts/local-block/pcie-sbr
#
# Recover a PCIe endpoint that U-Boot left in a state Linux will not re-enumerate.
#
# ---------------------------------------------------------------------------------------
# WHY THIS LOOKS NOTHING LIKE THE OLD VERSION
#
# Measured LIVE from inside the initramfs on a ROCK 3A + Penta SATA HAT (JMB585), after
# five failed/slow SD-less boots:
#
#     after 12s with the reset loop QUIETED : LinkStatus=0x3821 width=x2 DLL_Active=1
#     set Retrain Link (cap+0x10 bit 5)     : speed 1 -> 3   (2.5 -> 8.0 GT/s)
#     one PCI rescan                        : 0002:21:00.0 appeared, /dev/sda present
#
# The link was never broken. U-Boot trains it and hands off with LTSSM 0x30011; Linux's
# rk_pcie_establish_link() sees link_up() and returns early, so it simply never ENUMERATES
# bus 21. What the old hook did was assert a Secondary Bus Reset as its FIRST action --
# breaking a working link -- then rescan 2s later while the link was still down, then reset
# again ~8s after that. It destroyed the thing it was waiting for, and the apparent "1%
# success rate" was really "did a rescan happen to land in a quiet, settled window".
#
# So: escalate LEAST-INVASIVE FIRST, and never probe sooner than POST_RESET_S after doing
# anything that disturbs the link.
#
#   step 0  plain rescan, no reset at all      <- never tried on a virgin link before
#   step 1  Retrain Link, then rescan          <- also brings the link to Gen3
#   step 2  ONE SBR -> wait 10s -> retrain -> rescan
#   step 3  remove the ENDPOINT (not the bridge) -> rescan -> retrain
#   then repeat 2/3 until the budget runs out
#
# Other measured rules encoded here:
#   * Never SBR once a driver is bound to the endpoint: it detaches the device and produces
#     transient read errors (observed: ata2-6 "failed to stop engine (-19)").
#   * Remove/rescan of the ENDPOINT recovers the block devices WITHOUT dropping the link;
#     removing the BRIDGE drops it. Prefer the endpoint.
#   * Never read link state while a reset is asserted -- that is how we mis-diagnosed the
#     link as physically dead (DLL_Active reads 0 mid-SBR).
#   * initramfs-tools 0.140 only gives local-block ~30s of WALL CLOCK (slumber=30), so this
#     script owns its own budget and loops internally. `rootwait` does NOT help: init parses
#     only rootdelay=, and rootdelay=N adds a blind sleep to every boot.
#
# https://github.com/Mojo24x7/rock3a-sata-ssd-boot
# ---------------------------------------------------------------------------------------
PREREQ=""
prereqs(){ echo "$PREREQ"; }
case $1 in
  prereqs) prereqs; exit 0 ;;
esac

SETTLE_S=15          # max seconds to wait for the link to report Data Link Layer Active
POST_RESET_S=10      # quiet time after anything that disturbs the link, before probing
SBR_HOLD=1           # seconds to hold Secondary Bus Reset
LOOP_BUDGET_S=150    # our own retry budget inside ONE invocation
LOOP_MAX_STEPS=24
RETRAIN=yes          # set Retrain Link to recover Gen3 (safe: done before the disk is used)
[ -r /etc/pcie-sbr-boot.conf ] && . /etc/pcie-sbr-boot.conf

LOG=/run/pcie-sbr.log
CNT=/run/pcie-sbr.count
n=0
[ -f "$CNT" ] && n=$(cat "$CNT" 2>/dev/null)
n=$((n + 1)); echo "$n" > "$CNT"
log(){ echo "[pcie-sbr #$n] $*" >> "$LOG"; }

# --- low level ---------------------------------------------------------------

rdb(){ od -An -tu1 -j "$2" -N 1 "$1" 2>/dev/null | tr -d ' \n'; }
wrb(){ printf "\\$(printf '%03o' "$3")" | dd of="$1" bs=1 seek="$2" count=1 conv=notrunc 2>/dev/null; }
rdw(){ lo=$(rdb "$1" "$2"); hi=$(rdb "$1" $(( $2 + 1 )))
       case "$lo$hi" in ''|*[!0-9]*) return 1 ;; esac
       echo $(( hi * 256 + lo )); }

uptime_s(){ cut -d' ' -f1 /proc/uptime 2>/dev/null | cut -d. -f1; }

pcie_cap(){   # PCI Express capability offset, or fail
  cfg=/sys/bus/pci/devices/$1/config
  [ -r "$cfg" ] || return 1
  sr=$(rdb "$cfg" 6); case "$sr" in ''|*[!0-9]*) return 1 ;; esac
  [ $((sr & 16)) -ne 0 ] || return 1
  ptr=$(rdb "$cfg" 52); case "$ptr" in ''|*[!0-9]*) return 1 ;; esac
  ptr=$((ptr & 252)); i=0
  while [ "$ptr" -gt 0 ] && [ "$ptr" -ne 255 ] && [ "$i" -lt 48 ]; do
    cid=$(rdb "$cfg" "$ptr"); case "$cid" in ''|*[!0-9]*) return 1 ;; esac
    [ "$cid" -eq 16 ] && { echo "$ptr"; return 0; }
    nx=$(rdb "$cfg" $((ptr + 1))); case "$nx" in ''|*[!0-9]*) return 1 ;; esac
    ptr=$((nx & 252)); i=$((i + 1))
  done
  return 1
}

find_bridges(){ for d in /sys/bus/pci/devices/*; do [ -r "$d/class" ] || continue
  case "$(cat "$d/class" 2>/dev/null)" in 0x0604*) basename "$d" ;; esac; done; }

find_storage(){ for d in /sys/bus/pci/devices/*; do [ -r "$d/class" ] || continue
  case "$(cat "$d/class" 2>/dev/null)" in 0x0106*|0x0108*) basename "$d" ;; esac; done; }

rescan_pci(){  echo 1 > /sys/bus/pci/rescan 2>/dev/null; }
rescan_scsi(){ for h in /sys/class/scsi_host/host*; do [ -d "$h" ] && echo "- - -" > "$h/scan" 2>/dev/null; done; }

state(){ echo "pci=$(ls /sys/bus/pci/devices/ 2>/dev/null | tr '\n' ' ')blk=$(ls -d /dev/sd[a-z] /dev/nvme*n1 2>/dev/null | tr '\n' ' ')"; }

# initramfs passes "UUID=..." -- NOT a path -- so a bare [ -e "$1" ] can never be true.
target_present(){
  case "$1" in
    UUID=*)     [ -e "/dev/disk/by-uuid/${1#UUID=}" ] && return 0 ;;
    PARTUUID=*) [ -e "/dev/disk/by-partuuid/${1#PARTUUID=}" ] && return 0 ;;
    LABEL=*)    [ -e "/dev/disk/by-label/${1#LABEL=}" ] && return 0 ;;
    *)          [ -e "$1" ] && return 0 ;;
  esac
  return 1
}
any_disk_present(){ for d in /dev/sd? /dev/nvme?n1; do [ -b "$d" ] && return 0; done; return 1; }

# --- link -------------------------------------------------------------------

link_report(){   # link_report <bridge>  -> "speed=N width=xN active=N"
  cap=$(pcie_cap "$1") || { echo "unreadable"; return 1; }
  s=$(rdw /sys/bus/pci/devices/$1/config $((cap + 18))) || { echo "unreadable"; return 1; }
  echo "LinkStatus=0x$(printf %04X "$s") speed=$((s & 15)) width=x$(( (s >> 4) & 63 )) active=$(( (s >> 13) & 1 ))"
}

link_active(){
  cap=$(pcie_cap "$1") || return 1
  s=$(rdw /sys/bus/pci/devices/$1/config $((cap + 18))) || return 1
  [ $(( (s >> 13) & 1 )) -eq 1 ]
}

wait_link(){     # wait_link <bridge> <max_seconds> -- poll, do not blind-sleep
  i=0
  while [ "$i" -lt "$2" ]; do
    link_active "$1" && { log "    link active after ${i}s"; return 0; }
    sleep 1; i=$((i + 1))
  done
  log "    link NOT active after ${2}s"
  return 1
}

retrain(){       # nudge the downstream port to renegotiate; also recovers Gen3
  [ "$RETRAIN" = yes ] || return 0
  bdf=$1; cfg=/sys/bus/pci/devices/$bdf/config
  cur_s=$(cat "/sys/bus/pci/devices/$bdf/current_link_speed" 2>/dev/null)
  max_s=$(cat "/sys/bus/pci/devices/$bdf/max_link_speed" 2>/dev/null)
  cap=$(pcie_cap "$bdf") || return 1
  lc=$((cap + 16))
  cur=$(rdb "$cfg" "$lc"); case "$cur" in ''|*[!0-9]*) return 1 ;; esac
  wrb "$cfg" "$lc" $((cur | 32))          # bit 5 = Retrain Link
  sleep 3
  log "    retrain $bdf: $cur_s -> $(cat "/sys/bus/pci/devices/$bdf/current_link_speed" 2>/dev/null) (max $max_s)"
}

sbr(){           # Secondary Bus Reset: bit 6 of Bridge Control at config offset 0x3E
  bdf=$1; cfg=/sys/bus/pci/devices/$bdf/config
  [ -w "$cfg" ] || { log "    $bdf: config not writable"; return 1; }
  # NEVER reset while a driver holds the endpoint - it detaches the device and causes
  # transient I/O errors. If a disk is already visible we should not be here at all.
  if any_disk_present; then log "    refusing SBR: a disk is already present"; return 1; fi
  old=$(rdb "$cfg" 62); case "$old" in ''|*[!0-9]*) log "    $bdf: BridgeControl unreadable"; return 1 ;; esac
  log "    $bdf SBR: BridgeControl $old -> $((old | 64)), hold ${SBR_HOLD}s"
  wrb "$cfg" 62 $((old | 64)); sleep "$SBR_HOLD"; wrb "$cfg" 62 "$old"
}

probe(){         # settle -> retrain -> rescan -> scsi rescan. NO resets in here.
  br=$1
  wait_link "$br" "$SETTLE_S"
  retrain "$br"
  rescan_pci; sleep 2
  rescan_scsi; sleep 2
  log "    $(link_report "$br")"
}

# --- main -------------------------------------------------------------------

log "waiting for: $1"
log "  before: $(state)"
target_present "$1" && { log "  target already present, nothing to do"; exit 0; }

BR=$(find_bridges | head -1)
[ -n "$BR" ] || { log "  no PCI bridge found - nothing this script can do"; exit 0; }
log "  bridge: $BR   $(link_report "$BR")"

t0=$(uptime_s); [ -n "$t0" ] || t0=0
step=0
done_ok=0

while : ; do
  step=$((step + 1))
  el=$(( $(uptime_s) - t0 ))

  case "$step" in
    1)  log "  step 1: plain rescan, NO reset (the link is usually already up)"
        probe "$BR" ;;
    2)  log "  step 2: retrain + rescan"
        retrain "$BR"; rescan_pci; sleep 2; rescan_scsi; sleep 2 ;;
    *)  # alternate: SBR-then-settle, and endpoint remove-then-settle
        if [ $(( step % 2 )) -eq 1 ]; then
          log "  step $step: ONE SBR, then ${POST_RESET_S}s quiet, then retrain+rescan"
          sbr "$BR" && sleep "$POST_RESET_S"
          probe "$BR"
        else
          log "  step $step: remove the ENDPOINT (keeps the link up), rescan, retrain"
          for e in $(find_storage); do
            log "    removing $e"
            echo 1 > "/sys/bus/pci/devices/$e/remove" 2>/dev/null
          done
          sleep 2
          rescan_pci; sleep 3
          retrain "$BR"
          rescan_scsi; sleep 2
        fi ;;
  esac

  log "  after step $step (${el}s): $(state)"

  if target_present "$1"; then
    log "  *** TARGET PRESENT - step $step worked at ${el}s ***"
    log "      final: $(link_report "$BR")"
    done_ok=1; break
  fi
  if any_disk_present; then
    log "  *** a disk node appeared at step $step (${el}s) - stopping, letting initramfs resolve $1"
    log "      final: $(link_report "$BR")"
    done_ok=1; break
  fi

  el=$(( $(uptime_s) - t0 ))
  [ "$el" -ge "$LOOP_BUDGET_S" ] && { log "  budget ${LOOP_BUDGET_S}s spent after $step steps - giving up"; break; }
  [ "$step" -ge "$LOOP_MAX_STEPS" ] && { log "  step cap $LOOP_MAX_STEPS reached at ${el}s - giving up"; break; }
done

exit 0
