# /etc/default/pcie-sbr-boot
#
# Configuration for the initramfs PCIe recovery hook. Copied into the initramfs at build time
# by /etc/initramfs-tools/hooks/pcie-sbr, so run `update-initramfs -u` after changing anything.

# --- link recovery -----------------------------------------------------------
# U-Boot hands off with the PCIe link already trained, and Linux's rk_pcie_establish_link()
# returns early without enumerating the bus behind the bridge. The link itself is up, so the
# hook escalates least-invasive first: rescan -> retrain -> one SBR + settle -> endpoint remove.

# Max seconds to wait for the link to report Data Link Layer Active. Polled once a second and
# exits as soon as the link is up, so a healthy boot pays only what it needs.
SETTLE_S=15

# Quiet time after anything that disturbs the link, before probing again. Below ~10s the probe
# lands while the link is still training and sees nothing.
POST_RESET_S=10

# Set Retrain Link (bit 5 of Link Control) after a reset. A hot reset leaves the link at Gen1
# even though both ends advertise more and Link Control 2 already targets the maximum. On a
# multi-port SATA card this is the difference between ~500 MB/s and ~2 GB/s shared.
RETRAIN=yes

# Seconds to hold Secondary Bus Reset when it is needed at all.
SBR_HOLD=1

# How long the hook keeps retrying inside ONE invocation. It owns its own budget because
# initramfs-tools gives local-block only ~30s of wall clock (slumber=30 in scripts/local).
LOOP_BUDGET_S=150
LOOP_MAX_STEPS=24

# Network interface used for diagnostics and the rescue shell.
NET_IFACE=eth0

# --- diagnostics -------------------------------------------------------------
# If the boot fails, ship dmesg + PCI/SCSI/block state to this host over raw TCP.
# Leave empty to disable. Receiving end: python3 tools/diag_listener.py
DIAG_HOST=
DIAG_PORT=9999

# --- interactive rescue shell ------------------------------------------------
# yes = start `nc -ll -e /bin/sh` inside the initramfs while it waits for the root device.
#
# THIS IS AN UNAUTHENTICATED ROOT SHELL ON THE NETWORK. It is shut down before switch_root by
# scripts/init-bottom/pcie-sbr-shell-off, but enable it only while actively debugging.
# For routine access prefer dropbear-initramfs on its own port - see docs/REMOTE-DEBUG.md.
ENABLE_TELNET=no
TELNET_PORT=23
